APP_ENV=local
AUTH_MODE=demo
# Public demo recommendation: AUTH_MODE=password. Use at least 32 random bytes.
JWT_SECRET=
JWT_ISSUER=qbr-insight-agent
JWT_AUDIENCE=qbr-web
PASSWORD_USERNAME=
# Generate with: .venv/bin/python scripts/create_password_hash.py
PASSWORD_HASH=
PASSWORD_USER_ID=user_demo
PASSWORD_WORKSPACE_ID=ws_demo
SESSION_TTL_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300
QBR_DATA_DIR=./data
DATABASE_PATH=./data/sqlite/app.sqlite3
OBJECT_STORE_PATH=./data/objects
RUN_INLINE_WORKER=false
WORKER_POLL_SECONDS=1
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
LOG_LEVEL=INFO
MAX_UPLOAD_MIB=100
MAX_SLIDES=200
CORS_ORIGINS=http://localhost:3000

# Trusted runtime Skill roots. Separate multiple roots with the platform path separator.
SKILL_PATHS=./skills
# Leave empty to select the highest compatible version by capability.
PARSER_SKILL_NAME=
TABLE_REASONING_SKILL_NAME=

# Server-side OpenAI-compatible LLM (never expose this key to VITE_* variables)
LLM_ENABLED=false
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0.1

# Retrieval: fts (default), vector, or hybrid. FAISS is an optional install:
#   .venv/bin/pip install -e '.[vector]'
RETRIEVAL_STRATEGY=fts
VECTOR_INDEX_DIR=./data/vector_indexes
VECTOR_MIN_SIMILARITY=0.30
VECTOR_CANDIDATE_K=24
LEXICAL_CANDIDATE_K=24
RETRIEVAL_RRF_K=60
RETRIEVAL_LEXICAL_WEIGHT=1.25
RETRIEVAL_VECTOR_WEIGHT=1.0

# Semantic embeddings. Defaults to the LLM endpoint/key when omitted.
# Use EMBEDDING_PROVIDER=hashing only for offline tests and retrieval ablations.
EMBEDDING_PROVIDER=openai-compatible
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=0
EMBEDDING_BATCH_SIZE=32
