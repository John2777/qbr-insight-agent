{
  "dataset": "qbr-semantic-task-frame",
  "version": "3.0.0",
  "description": "Bilingual semantic task-frame, multi-goal coverage, query expansion and hard-constraint regression cases. No intent taxonomy is evaluated.",
  "cases": [
    {
      "id": "task-001",
      "question": "Summarize the key takeaways from this QBR.",
      "expected_task_terms": [["summarize", "key takeaways"]],
      "required_query_terms": ["executive summary", "performance"]
    },
    {
      "id": "task-002",
      "question": "请总结当前PPT的核心结论。",
      "expected_task_terms": [["总结", "核心结论"]],
      "required_query_terms": ["执行摘要", "核心事实"]
    },
    {
      "id": "task-003",
      "question": "请总结公司的优势和潜在问题。",
      "expected_task_terms": [["优势"], ["潜在问题"]],
      "required_query_terms": ["优势", "风险"]
    },
    {
      "id": "task-004",
      "question": "What potential issues should management investigate?",
      "expected_task_terms": [["potential issues"]],
      "required_query_terms": ["risk", "threshold"]
    },
    {
      "id": "task-005",
      "question": "当前文档里有哪些经营隐患？",
      "expected_task_terms": [["经营隐患"]],
      "required_query_terms": ["风险", "承压"]
    },
    {
      "id": "task-006",
      "question": "How did sales perform in Q2 2025?",
      "expected_task_terms": [["sales"], ["Q2 2025"]],
      "required_query_terms": ["revenue", "performance"],
      "hard_constraints": ["Q2", "2025"]
    },
    {
      "id": "task-007",
      "question": "2026年第一季度香港VONB是多少？",
      "expected_task_terms": [["VONB"], ["香港"]],
      "required_query_terms": ["VONB", "新业务价值"],
      "hard_constraints": ["2026年", "第一季度"]
    },
    {
      "id": "task-008",
      "question": "VONB是什么含义？",
      "expected_task_terms": [["VONB"], ["含义"]],
      "required_query_terms": ["VONB", "新业务价值"]
    },
    {
      "id": "task-009",
      "question": "VONB是什么含义，并分析图中的趋势？",
      "expected_task_terms": [["含义"], ["趋势"]],
      "required_query_terms": ["VONB", "trend"]
    },
    {
      "id": "task-010",
      "question": "Revenue 从 Q1 到 Q3 增长多少？",
      "expected_task_terms": [["Revenue"], ["增长多少"]],
      "required_query_terms": ["Revenue", "change"],
      "hard_constraints": ["Q1", "Q3"]
    },
    {
      "id": "task-011",
      "question": "Which region has the highest margin in 2025?",
      "expected_task_terms": [["highest margin"]],
      "required_query_terms": ["margin", "region"],
      "hard_constraints": ["2025"]
    },
    {
      "id": "task-012",
      "question": "所谓的执行风险具体是指什么？",
      "expected_task_terms": [["执行风险"], ["指什么"]],
      "required_query_terms": ["风险", "定义"]
    },
    {
      "id": "task-013",
      "question": "公司的优势在哪些点上？",
      "expected_task_terms": [["优势"]],
      "required_query_terms": ["strength", "growth"]
    },
    {
      "id": "task-014",
      "question": "公司的优劣势分别是什么？",
      "expected_task_terms": [["优势"], ["劣势"]],
      "required_query_terms": ["strength", "risk"]
    },
    {
      "id": "task-015",
      "question": "下一阶段有哪些增长机会？",
      "expected_task_terms": [["增长机会"]],
      "required_query_terms": ["growth", "opportunity"]
    },
    {
      "id": "task-016",
      "question": "哪些数据是公开披露，哪些是模拟数据？",
      "expected_task_terms": [["公开披露"], ["模拟数据"]],
      "required_query_terms": ["official disclosure", "synthetic"]
    },
    {
      "id": "task-017",
      "question": "请总结文档并说明每个结论的数据来源。",
      "expected_task_terms": [["总结"], ["数据来源"]],
      "required_query_terms": ["summary", "source"]
    },
    {
      "id": "task-018",
      "question": "比较香港和中国内地在26/03的表现。",
      "expected_task_terms": [["比较"], ["香港"], ["中国内地"]],
      "required_query_terms": ["comparison", "26/03"]
    },
    {
      "id": "task-019",
      "question": "2025年资本比率是否达到阈值？",
      "expected_task_terms": [["资本比率"], ["阈值"]],
      "required_query_terms": ["capital", "threshold"],
      "hard_constraints": ["2025年"]
    },
    {
      "id": "task-020",
      "question": "这份PPT表现如何，下一季度应关注什么？",
      "expected_task_terms": [["表现如何"], ["下一季度"]],
      "required_query_terms": ["performance", "actions"]
    }
  ]
}
