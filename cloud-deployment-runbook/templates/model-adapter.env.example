# DESIGN TARGET ONLY: the current codebase does not read these variables yet.
# Do not install this file until a reviewed model provider adapter exists.

LLM_PROVIDER=bedrock
LLM_MODEL=replace-with-reviewed-model-id
VISION_PROVIDER=bedrock
VISION_MODEL=replace-with-reviewed-vision-model-id
EMBEDDING_PROVIDER=replace-with-provider
EMBEDDING_MODEL=replace-with-reviewed-embedding-model-id
MODEL_TIMEOUT_SECONDS=60
MODEL_CONCURRENCY=2

# AWS Bedrock on EC2 should use the Instance Profile default credential chain.
AWS_REGION=replace-with-deployment-region

