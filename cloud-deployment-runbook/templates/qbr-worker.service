[Unit]
Description=QBR Insight Agent Worker
After=network-online.target qbr-api.service
Wants=network-online.target
RequiresMountsFor=/data/qbr

[Service]
Type=simple
User=qbr
Group=qbr
WorkingDirectory=/opt/qbr/app
EnvironmentFile=/etc/qbr/runtime.env
ExecStart=/opt/qbr/app/.venv/bin/python -m apps.worker.main
Restart=on-failure
RestartSec=5
TimeoutStopSec=120
UMask=0077

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# LibreOffice keeps its per-user profile here; parsing temp files use PrivateTmp.
ReadWritePaths=/data/qbr /opt/qbr/.config

[Install]
WantedBy=multi-user.target
