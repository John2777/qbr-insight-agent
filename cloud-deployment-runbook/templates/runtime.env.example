# This file contains only settings implemented by the current codebase.
# Install as /etc/qbr/runtime.env, owner root:qbr, mode 0640.

# Public AWS deployment must fail closed. Generate with: openssl rand -base64 48
APP_ENV=production
AUTH_MODE=password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=qbr-insight-agent
JWT_AUDIENCE=qbr-web
PASSWORD_USERNAME=interviewer
PASSWORD_HASH=replace-with-output-from-create_password_hash.py
PASSWORD_USER_ID=user_demo
PASSWORD_WORKSPACE_ID=ws_demo
SESSION_TTL_SECONDS=28800
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=300

QBR_DATA_DIR=/data/qbr
DATABASE_PATH=/data/qbr/app.sqlite3
OBJECT_STORE_PATH=/data/qbr/objects

MAX_UPLOAD_MIB=100
MAX_SLIDES=200

# A dedicated qbr-worker.service is used, so the API must not start another worker.
RUN_INLINE_WORKER=false
WORKER_POLL_SECONDS=1
JOB_LEASE_SECONDS=120
JOB_HEARTBEAT_SECONDS=30
JOB_MAX_ATTEMPTS=3
LOG_LEVEL=INFO

# Replace with the exact production origin. Never use * for a credentialed deployment.
CORS_ORIGINS=https://qbr.example.com
